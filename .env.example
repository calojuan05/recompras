# ---------------------------------------------------------------------------
# Copia este archivo como .env y rellena lo que necesites.
#
# La aplicación arranca SIN ninguna credencial: con `npm run seed` trae datos
# ficticios y las integraciones quedan en modo simulado. Las variables de abajo
# solo hacen falta cuando quieras conectar datos reales o enviar de verdad.
# ---------------------------------------------------------------------------

# --- Base de datos ---------------------------------------------------------
# SQLite por defecto: un archivo, cero dependencias.
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"

# Para PostgreSQL: corre `npm run db:postgres`, cambia estas dos líneas y migra.
# DATABASE_URL="postgresql://usuario:clave@localhost:5432/recompras"
# DATABASE_PROVIDER="postgresql"


# --- Lucid Bot (Chatrace) --------------------------------------------------
# El token se saca en el panel -> Configuración -> Integraciones -> API Token.
# El pipeline es el que contiene los pedidos; sus etapas son el estado de envío.
LUCIDBOT_BASE_URL="https://api.chatrace.com"
LUCIDBOT_TOKEN=""
LUCIDBOT_PIPELINE_ID=""
# Etapas separadas por coma. Solo las de "entregado" arrancan un ciclo:
# un pedido en tránsito o devuelto nunca llegó a consumirse.
LUCIDBOT_ETAPAS_ENTREGADO="Entregados"
LUCIDBOT_ETAPAS_DEVUELTO="Devueltos"
# Peticiones simultáneas al pedir contactos. Subirlo hace que la API corte.
LUCIDBOT_CONCURRENCIA="6"


# --- API REST genérica (opcional) ------------------------------------------
# Para conectar cualquier otro proveedor sin escribir código: el mapeo describe
# dónde está cada campo en su JSON. Ver docs/mapeo-ejemplo.json.
REST_API_BASE_URL=""
REST_API_KEY=""
REST_API_CABECERA="Authorization"
REST_API_MAPEO="{}"


# --- Envíos ----------------------------------------------------------------
# simulado = los mensajes se guardan en la bandeja y NO salen a ningún
# proveedor. Es el valor por defecto a propósito: evita que una prueba le
# escriba a un cliente real. Cambiarlo a "real" exige credenciales abajo.
MODO_ENVIO="simulado"

# WhatsApp Cloud API (solo si MODO_ENVIO=real)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# SMTP (solo si MODO_ENVIO=real y usas correo)
SMTP_HOST=""
SMTP_PUERTO="587"
SMTP_USUARIO=""
SMTP_CLAVE=""
SMTP_REMITENTE=""


# --- Motor de programación -------------------------------------------------
# El job diario corre dentro del proceso de Next. Ponlo en "false" si prefieres
# dispararlo solo a mano desde Configuración.
CRON_ACTIVO="true"
CRON_HORA="0 8 * * *"
ZONA_HORARIA="America/Bogota"
