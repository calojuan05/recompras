{
  "name": "recompras",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "prisma migrate deploy && tsx prisma/seed.ts",
    "seed:catalogo": "prisma migrate deploy && tsx prisma/seed.ts --solo-catalogo",
    "sync": "tsx scripts/sincronizar.ts",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:postgres": "tsx scripts/cambiar-motor.ts postgresql",
    "db:sqlite": "tsx scripts/cambiar-motor.ts sqlite",
    "postinstall": "prisma generate",
    "exportar": "tsx scripts/exportar.ts",
    "exportar:pagina": "tsx scripts/exportar-pagina.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
